"| precip ~", round(alpha * n_p, 1), "\n")
# ------- 2b: FDR correction (Benjamini-Hochberg) -----------------------------
cat("\n---------- 2b: FDR correction (Benjamini-Hochberg) ----------\n")
q <- 0.05
padj_grid <- function(pmat, q) {
